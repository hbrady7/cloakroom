{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "cloakroom-daily-brief",
  "type": "object",
  "required": ["date", "regime_note", "picks", "caution_list", "skipped"],
  "additionalProperties": false,
  "properties": {
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "regime_note": {"type": "string", "minLength": 1, "maxLength": 600},
    "picks": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "required": ["ticker", "direction", "conviction", "thesis",
                     "evidence_ids", "key_risks", "invalidation", "expression"],
        "additionalProperties": false,
        "properties": {
          "ticker": {"type": "string", "minLength": 1, "maxLength": 12},
          "direction": {"enum": ["long", "avoid"]},
          "conviction": {"enum": ["high", "medium", "speculative"]},
          "thesis": {"type": "string", "minLength": 20, "maxLength": 1100},
          "evidence_ids": {
            "type": "array", "minItems": 1, "maxItems": 30,
            "items": {"type": "string", "pattern": "^[CI]-[0-9a-f]{12}$"}
          },
          "key_risks": {
            "type": "array", "minItems": 1, "maxItems": 6,
            "items": {"type": "string", "minLength": 3, "maxLength": 300}
          },
          "invalidation": {"type": "string", "minLength": 5, "maxLength": 400},
          "expression": {
            "type": "object",
            "required": ["simple"],
            "additionalProperties": false,
            "properties": {
              "simple": {"type": "string", "minLength": 3, "maxLength": 200},
              "defined_risk_note": {"type": ["string", "null"], "maxLength": 500}
            }
          }
        }
      }
    },
    "caution_list": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "required": ["ticker", "reason"],
        "additionalProperties": false,
        "properties": {
          "ticker": {"type": "string", "minLength": 1, "maxLength": 12},
          "reason": {"type": "string", "minLength": 5, "maxLength": 500},
          "evidence_ids": {
            "type": "array", "maxItems": 30,
            "items": {"type": "string", "pattern": "^[CI]-[0-9a-f]{12}$"}
          }
        }
      }
    },
    "skipped": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "required": ["ticker", "reason"],
        "additionalProperties": false,
        "properties": {
          "ticker": {"type": "string", "minLength": 1, "maxLength": 12},
          "reason": {"type": "string", "minLength": 3, "maxLength": 400}
        }
      }
    }
  }
}
